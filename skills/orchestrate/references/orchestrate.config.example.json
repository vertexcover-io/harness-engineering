{
  "doctor": "bun bin/doctor.ts",

  "stages": {
    "setup": {},
    "worktree": {},
    "baseline": {},
    "planning": { "skill": "my-planning" },
    "coder": { "skill": "my-implement", "model": "opus" },
    "code-review": { "skill": "strict-review" },
    "verify-finalize": { "model": "haiku", "skills": { "quality-gate": "my-gate" } },
    "commit-pr": {},
    "retro": {}
  },

  "extensions": {
    "planning": "harness/planning.md"
  },

  "environments": {
    "default": "local",
    "local": {
      "stack_up": "scripts/stack.sh up {BRANCH} {SERVICE...} [--seed-demo]",
      "stack_status": "scripts/stack.sh status {BRANCH}",
      "stack_urls": "scripts/stack.sh urls {BRANCH}",
      "stack_down": "scripts/stack.sh down {BRANCH}",
      "service_port": "scripts/stack.sh port {SERVICE} {BRANCH}",
      "seed": "pnpm seed --branch {BRANCH}",
      "auth": "pnpm auth --branch {BRANCH}"
    },
    "remote": {
      "stack_up": "scripts/ref.sh up --branch {BRANCH} {REPO...}",
      "stack_wait": "scripts/ref.sh wait --branch {BRANCH} --timeout 40m",
      "stack_status": "scripts/ref.sh status --branch {BRANCH} --json",
      "stack_urls": "scripts/ref.sh urls --branch {BRANCH} --json",
      "stack_list": "scripts/ref.sh list --json",
      "stack_down": "scripts/ref.sh down --branch {BRANCH}",
      "seed": "pnpm seed --ref --branch {BRANCH}",
      "auth": "pnpm auth --branch {BRANCH}"
    }
  },

  "notifier": { "enabled": true, "provider": "slack" },

  "hooks": {
    "stage-completed": [
      { "name": "page-me", "when": { "stage": "coder", "result": "fail" },
        "cmd": "scripts/page-me.sh", "required": true },
      { "name": "stage-log", "report": true,
        "fn": { "module": "harness/hooks.ts", "export": "onStageDone" } }
    ],
    "artifact-created": [
      { "name": "link-pr", "when": { "kind": "pr" },
        "fn": { "module": "harness/hooks.ts", "export": "linkPr" } }
    ],
    "run-completed": [
      { "name": "cleanup", "cmd": "scripts/teardown.sh" }
    ],
    "hook-failed": [
      { "name": "page-oncall", "cmd": "scripts/page-oncall.sh" }
    ]
  },

  "commands": {
    "typecheck": "pnpm typecheck",
    "lint": "pnpm eslint .",
    "lint_file": "pnpm eslint {FILE}",
    "build": "pnpm build",
    "test_all": "pnpm vitest run",
    "test_file": "pnpm vitest run {FILE}",
    "coverage_all": "pnpm vitest run --coverage"
  },

  "packages": {
    "api": {
      "path": "packages/api",
      "runner": "vitest",
      "commands": {
        "bootstrap": "pnpm install",
        "build": "pnpm --filter api build",
        "test_all": "pnpm --filter api test",
        "test_file": "pnpm --filter api test {FILE}",
        "coverage_all": "pnpm --filter api test --coverage",
        "e2e": "pnpm --filter api test:e2e"
      }
    },
    "schemas": {
      "path": "packages/schemas",
      "commands": {
        "bootstrap": "pnpm install",
        "build": "pnpm --filter schemas build"
      }
    }
  }
}

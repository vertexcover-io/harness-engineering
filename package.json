{
  "name": "harness-engineering",
  "version": "1.32.0",
  "private": true,
  "type": "module",
  "workspaces": [
    "packages/*"
  ],
  "engines": {
    "node": ">=22.12",
    "bun": ">=1.2"
  },
  "scripts": {
    "typecheck": "bun run --filter '@harness/*' typecheck && tsc -p skills/create-workspace && tsc -p skills/ticket-fetcher && tsc -p skills/baseline && tsc -p skills/qa",
    "test": "bun test ./packages ./skills/create-workspace ./skills/ticket-fetcher ./skills/baseline ./skills/qa",
    "lint": "biome check",
    "check": "bun scripts/check.ts",
    "lint:fix": "biome check --write",
    "cli": "bun packages/cli/src/index.ts",
    "orchestrate": "bun packages/core/src/orchestrate.ts",
    "workspace": "bun skills/create-workspace/scripts/workspace.ts",
    "ticket": "bun skills/ticket-fetcher/scripts/ticket.ts",
    "baseline": "bun skills/baseline/scripts/baseline.ts",
    "linear": "bun skills/ticket-fetcher/scripts/linear.ts",
    "release:version": "bun scripts/version.ts",
    "release:version:node": "node scripts/version.ts",
    "test:scripts": "node --test scripts/*.test.ts",
    "test:scripts:bun": "bun test scripts/",
    "test:hooks": "node --test hooks/*.test.mjs",
    "test:skills": "node --experimental-strip-types --test \"skills/!(create-workspace|ticket-fetcher|baseline|qa)/**/*.test.ts\" \"skills/**/*.test.mjs\""
  },
  "pi": {
    "skills": [
      "./skills"
    ],
    "extensions": [
      "./extensions/pi/harness-hooks.ts"
    ]
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.14",
    "@types/bun": "^1.4.2",
    "typescript": "^7.0.2"
  }
}

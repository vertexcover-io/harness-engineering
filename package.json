{
  "name": "harness-engineering",
  "version": "1.31.1",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.6"
  },
  "scripts": {
    "release:version": "bun scripts/version.ts",
    "release:version:node": "node scripts/version.ts",
    "test:scripts": "node --test scripts/*.test.ts",
    "test:scripts:bun": "bun test scripts/",
    "test:hooks": "node --test hooks/*.test.mjs",
    "test:skills": "node --experimental-strip-types --test skills/_shared/*.test.ts skills/orchestrate/scripts/*.test.ts skills/planning/scripts/*.test.ts skills/planning/scripts/*.test.mjs"
  },
  "pi": {
    "skills": ["./skills"],
    "extensions": ["./extensions/pi/harness-hooks.ts"]
  }
}

{
  "name": "harness-engineering",
  "version": "1.32.0",
  "private": true,
  "type": "module",
  "workspaces": [
    "packages/*"
  ],
  "engines": {
    "node": ">=22.12",
    "bun": ">=1.3.3"
  },
  "scripts": {
    "typecheck": "bun run --filter '@yok/*' typecheck && tsc -p skills/create-workspace && tsc -p skills/ticket-fetcher && tsc -p skills/baseline && tsc -p skills/qa && tsc -p skills/retro",
    "test": "bun test ./packages ./skills/create-workspace ./skills/ticket-fetcher ./skills/baseline ./skills/qa ./skills/retro",
    "lint": "biome check",
    "check": "bun scripts/check.ts",
    "lint:fix": "biome check --write",
    "cli": "bun --no-env-file packages/cli/src/index.ts",
    "orchestrate": "bun packages/core/src/orchestrate.ts",
    "workspace": "bun skills/create-workspace/scripts/workspace.ts",
    "ticket": "bun skills/ticket-fetcher/scripts/ticket.ts",
    "baseline": "bun skills/baseline/scripts/baseline.ts",
    "retro": "bun skills/retro/scripts/retro.ts",
    "linear": "bun skills/ticket-fetcher/scripts/linear.ts",
    "asana": "bun skills/ticket-fetcher/scripts/asana.ts",
    "release:version": "bun scripts/version.ts",
    "release:version:node": "node scripts/version.ts",
    "test:scripts": "node --test scripts/*.test.ts",
    "test:scripts:bun": "bun test scripts/",
    "test:hooks": "node --test hooks/*.test.mjs"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.14",
    "@types/bun": "^1.4.2",
    "typescript": "^7.0.2"
  }
}

{
  "stages": {
    "setup": {},
    "worktree": {},
    "baseline": {},
    "planning": {},
    "coder": {},
    "code-review": {},
    "verify": {},
    "quality-gate": {},
    "sync-docs": {},
    "commit-pr": {},
    "retro": {}
  },
  "commands": {
    "test_all": "node --test \"skills/**/*.test.ts\" \"skills/**/*.test.mjs\" \"scripts/**/*.test.ts\" \"hooks/**/*.test.mjs\" \"extensions/**/*.test.mjs\"",
    "test_file": "node --test {FILE}"
  },
  "packages": {
    "harness": {
      "path": ".",
      "runner": "node-test",
      "commands": {
        "test_all": "node --test \"skills/**/*.test.ts\" \"skills/**/*.test.mjs\" \"scripts/**/*.test.ts\" \"hooks/**/*.test.mjs\" \"extensions/**/*.test.mjs\"",
        "test_file": "node --test {FILE}"
      }
    },
    "v2": {
      "path": ".",
      "runner": "bun",
      "commands": {
        "bootstrap": "bun install",
        "typecheck": "bun run typecheck",
        "lint": "bun run lint",
        "test_all": "bun test ./packages",
        "test_file": "bun test {FILE}"
      }
    }
  },
  "notifier": { "enabled": false, "provider": "slack" },
  "samskara": { "enabled": true }
}
